<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<osmnt = 'http://www.jahia.org/opengraph-schemaorg-metadata/nt/1.0'>
<osmmix = 'http://www.jahia.org/opengraph-schemaorg-metadata/mix/1.0'>
<osm = 'http://www.jahia.org/opengraph-schemaorg-metadata/1.0'>

[osmnt:settings] > nt:base, jmix:nolive
 + * (osmnt:typeMapping)

// A mapping without osmmix:openGraph writes no Open Graph tag, and a mapping without osmmix:schemaOrg writes no JSON-LD.
[osmnt:typeMapping] > nt:base
 - osm:nodeType (string, choicelist[osmContentTypes]) mandatory
// A template mapping applies to the contents whose j:templateName holds osm:templateName. The value * applies to every template.
 - osm:templateName (string, choicelist[osmTemplates,dependentProperties='osm:nodeType']) = '*' mandatory

// Each osm:og_* property holds the name of the source property that fills one Open Graph property of every og:type.
[osmmix:openGraph] mixin
 extends = osmnt:typeMapping
 - osm:og_title (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_description (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_determiner (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_image (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_image_secure_url (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_image_alt (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_audio (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_audio_secure_url (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_audio_type (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_video (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_video_secure_url (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_video_type (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_video_width (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_video_height (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:og_video_alt (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:ogType (string, choicelist[osmOgTypes]) = 'website' mandatory < 'website', 'article', 'book', 'profile', 'music.song', 'music.album', 'music.playlist', 'music.radio_station', 'video.movie', 'video.episode', 'video.tv_show', 'video.other'

// The value of osm:schemaType adds the mixin of its schema.org properties.
[osmmix:schemaOrg] mixin
 extends = osmnt:typeMapping
 - osm:schemaType (string, choicelist[osmSchemaTypes]) mandatory < 'Article', 'NewsArticle', 'BlogPosting', 'WebPage', 'ProfilePage', 'Product', 'Event', 'Recipe', 'VideoObject'

// The value of osm:ogType adds the mixin of its own Open Graph properties.
[osmmix:article] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:article_published_time (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:article_modified_time (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:article_expiration_time (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:article_author (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:article_section (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:article_tag (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

[osmmix:book] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:book_author (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:book_isbn (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:book_release_date (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:book_tag (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

// Each value is a JSON object that sets one Open Graph tag, such as {"property":"og:title","content":"Summer in Mykonos"}.
// An image holds the identifier of its file instead, such as {"property":"og:image","node":"<uuid>"}.
// The selector type OsmTag edits a value: a forms file sets it, because a CND accepts only the selector types of Jahia.
[osmmix:customTags] mixin
 extends = jmix:mainResource, jnt:page
 - osm:customTags (string) i18n multiple

// Each value is a JSON object that sets one schema.org property, such as {"property":"author.name","content":"Ada Lovelace"}.
// An image holds the identifier of its file instead, such as {"property":"image","node":"<uuid>"}.
// The selector type OsmSchemaValue edits a value: a forms file sets it, as for osm:customTags.
[osmmix:customSchemaOrg] mixin
 extends = jmix:mainResource, jnt:page
 - osm:customSchemaOrg (string) i18n multiple

// Two mixins that share an Open Graph property declare the same storage name, such as osm:music_song.
// A mapping carries one of these mixins at a time, because the JCR refuses two declarations of one name on a node.
[osmmix:musicAlbum] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:music_song (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_song_disc (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_song_track (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_musician (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_release_date (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

[osmmix:musicPlaylist] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:music_song (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_song_disc (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_song_track (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_creator (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

[osmmix:musicRadioStation] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:music_creator (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

[osmmix:musicSong] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:music_duration (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_album (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_album_disc (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_album_track (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:music_musician (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

[osmmix:profile] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:profile_first_name (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:profile_last_name (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:profile_username (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:profile_gender (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

// Each osm:schema_* property holds the name of the source property that fills one schema.org property, such as
// osm:schema_author_name for author.name, the name of the Person of the author.
// Two mixins that share a schema.org property declare the same storage name, as the mixins of the og:types do.
[osmmix:schemaArticle] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:schema_headline (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_description (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_image (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_datePublished (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_dateModified (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_author_name (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])

[osmmix:schemaNewsArticle] > jmix:dynamicFieldset mixin
 extends = osmnt:typeMapping
 - osm:schema_headline (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_description (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_image (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_datePublished (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_dateModified (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])
 - osm:schema_author_name (string, choicelist[osmSourceProperties,dependentProperties='osm:nodeType'])


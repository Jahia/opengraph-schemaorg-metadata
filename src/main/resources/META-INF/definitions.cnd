<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<sdmnt = 'http://www.jahia.org/structured-data-mapper/nt/1.0'>
<sdmmix = 'http://www.jahia.org/structured-data-mapper/mix/1.0'>
<sdm = 'http://www.jahia.org/structured-data-mapper/1.0'>

[sdmnt:settings] > nt:base, jmix:nolive
 + * (sdmnt:typeMapping)

// A mapping without sdmmix:openGraph writes no Open Graph tag, and a mapping without sdmmix:schemaOrg writes no JSON-LD.
[sdmnt:typeMapping] > nt:base
 - sdm:nodeType (string, choicelist[sdmContentTypes]) mandatory
// A template mapping applies to the contents whose j:templateName holds sdm:templateName. The value * applies to every template.
 - sdm:templateName (string, choicelist[sdmTemplates,dependentProperties='sdm:nodeType']) = '*' mandatory

// Each sdm:og_* property holds the name of the source property that fills one Open Graph property of every og:type.
[sdmmix:openGraph] mixin
 extends = sdmnt:typeMapping
 - sdm:og_title (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_description (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_determiner (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_image (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_image_secure_url (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_image_alt (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_audio (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_audio_secure_url (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_audio_type (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_video (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_video_secure_url (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_video_type (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_video_width (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_video_height (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:og_video_alt (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:ogType (string, choicelist[sdmOgTypes]) mandatory < 'website', 'article', 'book', 'profile', 'music.song', 'music.album', 'music.playlist', 'music.radio_station', 'video.movie', 'video.episode', 'video.tv_show', 'video.other'

// The value of sdm:schemaType adds the mixin of its schema.org properties.
[sdmmix:schemaOrg] mixin
 extends = sdmnt:typeMapping
 - sdm:schemaType (string, choicelist[sdmSchemaTypes]) mandatory < 'Article', 'NewsArticle', 'BlogPosting', 'WebPage', 'ProfilePage', 'Product', 'Event', 'Recipe', 'VideoObject'

// The value of sdm:ogType adds the mixin of its own Open Graph properties.
[sdmmix:article] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:article_published_time (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:article_modified_time (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:article_expiration_time (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:article_author (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:article_section (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:article_tag (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

[sdmmix:book] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:book_author (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:book_isbn (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:book_release_date (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:book_tag (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

// Each value is a JSON object that sets one Open Graph tag, such as {"property":"og:title","content":"Summer in Mykonos"}.
// An image holds the identifier of its file instead, such as {"property":"og:image","node":"<uuid>"}.
// The selector type SdmTag edits a value: a forms file sets it, because a CND accepts only the selector types of Jahia.
[sdmmix:customTags] mixin
 extends = jmix:mainResource, jnt:page
 - sdm:customTags (string) i18n multiple

// Two mixins that share an Open Graph property declare the same storage name, such as sdm:music_song.
// A mapping carries one of these mixins at a time, because the JCR refuses two declarations of one name on a node.
[sdmmix:musicAlbum] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:music_song (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_song_disc (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_song_track (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_musician (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_release_date (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

[sdmmix:musicPlaylist] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:music_song (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_song_disc (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_song_track (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_creator (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

[sdmmix:musicRadioStation] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:music_creator (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

[sdmmix:musicSong] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:music_duration (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_album (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_album_disc (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_album_track (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:music_musician (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

[sdmmix:profile] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:profile_first_name (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:profile_last_name (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:profile_username (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:profile_gender (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

// Each sdm:schema_* property holds the name of the source property that fills one schema.org property, such as
// sdm:schema_author_name for author.name, the name of the Person of the author.
// Two mixins that share a schema.org property declare the same storage name, as the mixins of the og:types do.
[sdmmix:schemaArticle] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:schema_headline (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_description (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_image (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_datePublished (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_dateModified (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_author_name (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

[sdmmix:schemaNewsArticle] > jmix:dynamicFieldset mixin
 extends = sdmnt:typeMapping
 - sdm:schema_headline (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_description (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_image (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_datePublished (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_dateModified (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])
 - sdm:schema_author_name (string, choicelist[sdmSourceProperties,dependentProperties='sdm:nodeType'])

